            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains relationship data\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.expect(json.relationshipId).to.exist;\r",
                  "    pm.expect(json.name).to.eql(\"Brandon and Michelle's Pond\");\r",
                  "    pm.expect(json.relationshipMemberId).to.exist;\r",
                  "    pm.expect(json.displayName).to.eql(\"Brandon\");\r",
                  "    pm.expect(json.role).to.eql(\"Owner\");\r",
                  "    pm.expect(json.joinedAt).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Save relationshipId for later tests\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.collectionVariables.set(\"relationshipId\", json.relationshipId);\r",
                  "});"
