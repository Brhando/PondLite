      "name": "AuthTests",
      "item": [
        {
          "name": "Register Account Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has auth data\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.expect(json.userAccountId).to.exist;\r",
                  "    pm.expect(json.username).to.eql(pm.collectionVariables.get(\"testUsername\"));\r",
                  "    pm.expect(json.email).to.eql(pm.collectionVariables.get(\"testEmail\"));\r",
                  "    pm.expect(json.token).to.exist;\r",
                  "    pm.expect(json.expiresAt).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Save auth response values\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.collectionVariables.set(\"userAccountId\", json.userAccountId);\r",
                  "    pm.collectionVariables.set(\"username\", json.username);\r",
                  "    pm.collectionVariables.set(\"email\", json.email);\r",
                  "    pm.collectionVariables.set(\"token\", json.token);\r",
                  "    pm.collectionVariables.set(\"expiresAt\", json.expiresAt);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"{{testUsername}}\",\r\n  \"email\": \"{{testEmail}}\",\r\n  \"password\": \"{{testPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
